# ─── Required ────────────────────────────────────────────────────────────────

# Deployed PortalHook contract address (MUST be set before starting)
PORTAL_ADDRESS=0x0000000000000000000000000000000000000000

# PostgreSQL connection string (TypeORM uses this to connect)
# Local:   postgres://user:password@localhost:5432/portal_db
# Railway: provided automatically as DATABASE_URL
Db_URL=postgres://user:password@localhost:5432/portal_db

# ─── Optional (have defaults) ─────────────────────────────────────────────────

# JSON-RPC endpoint — defaults to local Anvil
RPC_URL=http://127.0.0.1:8545

# Backend server port — defaults to 3001
PORT=3001

# Wallet private key for sending on-chain transactions from the backend
# Leave blank to run in read-only / event-listener mode
PRIVATE_KEY=

# ─── Fhenix (leave blank for local dev — falls back to keccak256 shim) ───────

# Fhenix-compatible RPC endpoint (e.g. Fhenix Helium testnet)
FHENIX_RPC_URL=

# Fhenix chain ID — defaults to 69000 (Helium testnet)
FHENIX_CHAIN_ID=69000
